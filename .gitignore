# Byte-compiled / optimized / cache files
__pycache__/
*.py[cod]
*$py.class
*.so

# Testing and linting caches
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
ENV/
env/

# Environment variables and secrets
.env
.env.*
*.env
.env.local
!.env.example

# Database files and SQLite runtime artifacts
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
instance/

# Data stages and private datasets
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Sample demonstration data remains tracked in git
!data/sample/
!data/sample/**

# Portfolio images folder remains tracked in git
!images/
!images/**

# Machine learning model binaries
models/*.pkl
models/*.joblib
models/*.pt
models/*.onnx
!models/.gitkeep

# Generated outputs and temporary exports (exports folder preserved for runtime user exports)
outputs/exports/*
!outputs/exports/.gitkeep

# Analytical figures and numerical results are tracked for portfolio presentation
!reports/figures/
!reports/figures/**
!reports/results/
!reports/results/**

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Operating system and editor artifacts
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
.idea/
.vscode/*
!.vscode/settings.json

# Temporary logs and development scratch files
*.log
scratch/

# Private developer interview preparation and study materials (excluded from GitHub)
docs/INTERVIEW_PREPARATION.md
docs/*INTERVIEW*
docs/*PREPARATION*
docs/*interview*
docs/*prep*

# Private local cleanup and environment restoration documentation (excluded from GitHub)
docs/CLEANUP_AND_RESTORATION.md
docs/*CLEANUP*
docs/*RESTORATION*
docs/*cleanup*
docs/*restoration*


